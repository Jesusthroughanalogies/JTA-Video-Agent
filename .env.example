# Copy to .env and fill in. .env is git-ignored and is only read by the running agent.

# Claude (Agent SDK): an API key, or log in once with the `claude` CLI on this machine
ANTHROPIC_API_KEY=
# JTA_MODEL=claude-opus-5-5

# Higgsfield MCP server (generation, status, history, balance)
HIGGSFIELD_MCP_URL=
HIGGSFIELD_MCP_TOKEN=

# ElevenLabs voice clones (Section 6.2): ids live here, never in code
ELEVENLABS_API_KEY=
MATT_VOICE_ID=
JACK_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0.0
# JTA_VOICE_CHAR_CAP=25000

# ---- Trial Reel Agent (jta-reels) ----
